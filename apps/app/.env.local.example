# navigatr frontend — local environment.
#
# Copy this file to `.env.local` (gitignored) and replace the placeholders
# with your actual Supabase project values. Vite reads everything prefixed
# with `VITE_` and exposes it on `import.meta.env`.
#
# IMPORTANT — what's safe to put here:
#   - VITE_SUPABASE_URL          : safe to commit (public)
#   - VITE_SUPABASE_ANON_KEY     : safe to commit by design — it's the
#                                  client-side public key. Row-level
#                                  security policies enforce real auth.
#                                  Service-role keys ARE secret. Never put
#                                  one in any file starting with VITE_.
#   - VITE_API_BASE_URL          : safe (just a URL)
#
# But by convention we still don't commit `.env.local` — keeps real values
# out of git and forces every dev to think about which environment they're
# pointing at.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:5000

# Observability (Sentry). Leave VITE_SENTRY_DSN unset for local dev — the
# frontend works fine without it. Set in staging + production envs.
# VITE_SENTRY_DSN=https://your-public-key@oXXXX.ingest.sentry.io/XXXX
# VITE_SENTRY_ENVIRONMENT=dev      # dev | staging | production
# VITE_RELEASE=                    # usually set by CI to the git SHA
