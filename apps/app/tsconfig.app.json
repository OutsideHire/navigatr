{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": [
    "src",
    "../../supabase/functions/_shared/industryTaxonomy.ts",
    "../../supabase/functions/_shared/calendarQualify.ts",
    "../../supabase/functions/_shared/googleEvent.ts",
    "../../supabase/functions/_shared/googleToken.ts",
    "../../supabase/functions/_shared/calendarProviders/types.ts",
    "../../supabase/functions/_shared/calendarProviders/index.ts",
    "../../supabase/functions/_shared/calendarProviders/google.ts",
    "../../supabase/functions/_shared/calendarProviders/microsoft.ts",
    "../../supabase/functions/_shared/coverage/config.ts",
    "../../supabase/functions/_shared/coverage/score.ts"
  ]
}
